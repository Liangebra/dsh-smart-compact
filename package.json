{
  "name": "dsh-smart-compact",
  "version": "0.2.1",
  "description": "Custom DSH CompactionEngine backend: configurable threshold prompting, mandatory fallback at the limit, DCP-inspired dedup/purge, custom summary prompt, and /compact like the original. Zero external state — everything is rebuilt from the append-only session log.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "README.zh.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-compaction": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.2.0-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.3-alpha.2",
    "@deepseek-ai/schemastery": "3.20.0-alpha.1",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@deepseek-ai/dsh-commands": "0.2.3-alpha.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liangebra/dsh-smart-compact.git"
  },
  "homepage": "https://github.com/Liangebra/dsh-smart-compact#readme",
  "bugs": {
    "url": "https://github.com/Liangebra/dsh-smart-compact/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context-compaction",
    "context-pruning",
    "tui",
    "agent"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
